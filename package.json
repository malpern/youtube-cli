{
  "name": "youtube-watchlist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25 <26"
  },
  "bin": {
    "youtube-watchlist": "./src/cli.ts"
  },
  "scripts": {
